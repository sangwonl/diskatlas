{
  "name": "diskatlas",
  "version": "0.2.1",
  "private": true,
  "description": "An interactive map for exploring disk usage.",
  "type": "module",
  "bin": {
    "diskatlas": "./bin/diskatlas.mjs"
  },
  "scripts": {
    "scan": "node ./bin/diskatlas.mjs scan",
    "gui": "node ./bin/diskatlas.mjs gui",
    "start": "node ./bin/diskatlas.mjs gui",
    "wails:dev": "wails dev",
    "wails:build": "wails build",
    "release:mac:store": "bash scripts/release/macos.sh app-store",
    "release:mac:direct": "bash scripts/release/macos.sh direct",
    "release:windows:store": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release/windows.ps1 -Channel Store",
    "release:windows:direct": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release/windows.ps1 -Channel Direct"
  }
}
